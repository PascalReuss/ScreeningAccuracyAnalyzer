# Copy to .env and fill in. .env is git-ignored.
PAULSJOB_API_KEY=
PAULSJOB_API_BASE_URL=https://api.paulsjob.ai/dev/v1

# Optional
SCREENING_CACHE_TTL=900
FLASK_DEBUG=1

# Set to 1 to run against the bundled demo dataset instead of the live API
# (no API key needed). Regenerate the data with: python demo/generate.py
SCREENING_DEMO=0
